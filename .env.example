# OWLmon 환경변수 예시
# 사용법: cp .env.example .env  →  실제 값 채우기 (.env는 git에 안 올라감)

# ─── 관리자 계정 ───────────────────────────────────────
# username (기본 admin 그대로 둬도 됨)
OWLMON_USERNAME=admin

# bcrypt 해시 — 평문 비밀번호 X
# 생성 방법:
#   docker run --rm -it --entrypoint sh golang:1.26-alpine -c \
#     'cd /tmp && wget -q https://raw.githubusercontent.com/seongJae/owlmon/main/server/cmd/hashpw/main.go || true'
# 또는 로컬에서:
#   cd server && go run ./cmd/hashpw "내비밀번호"
# 출력된 $2a$로 시작하는 해시를 아래에 붙여넣기 (반드시 작은따옴표로 감싸기)
OWLMON_PASSWORD_HASH='$2a$10$REPLACE_WITH_YOUR_BCRYPT_HASH'

# JWT 서명키 (비워두면 컨테이너가 자동 생성/영속화)
OWLMON_JWT_SECRET=

# ─── SMTP (이메일 알림) ─────────────────────────────────
# 안 쓸 거면 SMTP_HOST 비워두면 됨 (알림 자동 비활성)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=owlmon@example.com
SMTP_TO=ops@example.com
